# Copy this file to ".env" (same folder) and fill in real values there.
# ".env" is listed in .gitignore - it is never committed to git.

# Where the SQLite task database lives (relative to the project root).
DATABASE_PATH=tasks.db

# --- Best Practice: Rate Limiting (applies to send_task_summary_email) ---
EMAIL_RATE_LIMIT_MAX=3
EMAIL_RATE_LIMIT_WINDOW_SECONDS=60

# --- Email authentication (optional) ---
# Leave the two lines below BLANK to run in "dry-run" mode: emails are saved
# as .eml files under drafts/ instead of being sent. This is the easiest way
# to try the server out.
#
# To send real email via Gmail instead:
#   1. Turn on 2-Step Verification on your Google account.
#   2. Create an "App Password" at https://myaccount.google.com/apppasswords
#      (this is a 16-character password made specifically for apps like this
#      one - it is NOT your normal Google password, and you can revoke it
#      any time without affecting your main login).
#   3. Put your Gmail address and that app password below.
SMTP_EMAIL_ADDRESS=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
